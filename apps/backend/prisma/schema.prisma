generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String         @id @default(uuid())
  email             String         @unique
  password          String?
  fullName          String
  phone             String?
  role              UserRole
  isActive          Boolean        @default(true)
  mustSetPassword   Boolean        @default(false)
  invitationCode    String?        @unique
  invitationExpires DateTime?
  lastLoginAt       DateTime?
  createdById       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  avatarUrl         String?
  auditLogs         AuditLog[]
  orderHistories    OrderHistory[]
  ordersHandled     Order[]        @relation("OrderCommercial")
  createdBy         User?          @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers      User[]         @relation("UserCreatedBy")

  @@index([role])
  @@map("users")
}

model School {
  id        String   @id @default(uuid())
  name      String
  city      String
  address   String?
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schoolLists  SchoolList[]
  schoolGrades SchoolGrade[]
  Order        Order[]
}

model Grade {
  id        String   @id @default(uuid())
  name      String
  cycle     String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schoolLists  SchoolList[]
  orders       Order[]
  schoolGrades SchoolGrade[]

  @@map("grades")
}

model SchoolGrade {
  schoolId String
  gradeId  String

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  grade  Grade  @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([schoolId, gradeId])
}

model SchoolList {
  id        String           @id @default(uuid())
  schoolId  String?
  gradeId   String?
  source    SchoolListSource @default(OFFICIAL)
  fileUrl   String?
  rawText   String?
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  items     SchoolListItem[]
  grade     Grade?           @relation(fields: [gradeId], references: [id])
  school    School?          @relation(fields: [schoolId], references: [id])
  orders    Order[]          // ← ajouté

  @@index([schoolId, gradeId])
  @@map("school_lists")
}

model SchoolListItem {
  id           String     @id @default(uuid())
  schoolListId String
  productId    String?
  label        String
  quantity     Int        @default(1)
  product      Product?   @relation(fields: [productId], references: [id])
  schoolList   SchoolList @relation(fields: [schoolListId], references: [id], onDelete: Cascade)

  @@map("school_list_items")
}

model Category {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  parentId  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  parent    Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryParent")
  products  Product[]

  @@map("categories")
}

model Product {
  id              String           @id @default(uuid())
  name            String
  description     String?
  sku             String?          @unique
  price           Decimal          @db.Decimal(10, 2)
  imageUrl        String?
  categoryId      String?
  stock           Int              @default(0)
  isBook          Boolean          @default(false)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  orderItems      OrderItem[]
  category        Category?        @relation(fields: [categoryId], references: [id])
  schoolListItems SchoolListItem[]

  @@index([categoryId])
  @@map("products")
}

model Order {
  id              String         @id @default(uuid())
  orderNumber     String         @unique
  customerName    String
  customerPhone   String
  customerEmail   String?
  customerGender  Gender?
  customerRole    CustomerRole?
  deliveryAddress String?
  schoolId        String?
  gradeId         String?
  schoolListId    String?        // ← ajouté : lien vers la liste custom soumise
  status          OrderStatus    @default(CREATED)
  note            String?
  totalAmount     Decimal        @default(0) @db.Decimal(10, 2)
  commercialId    String?
  qrCodeUrl       String?
  pdfUrl          String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  history         OrderHistory[]
  items           OrderItem[]
  commercial      User?          @relation("OrderCommercial", fields: [commercialId], references: [id])
  grade           Grade?         @relation(fields: [gradeId], references: [id])
  school          School?        @relation(fields: [schoolId], references: [id])
  schoolList      SchoolList?    @relation(fields: [schoolListId], references: [id])  // ← ajouté

  @@index([status])
  @@index([commercialId])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String?
  label     String
  quantity  Int      @default(1)
  unitPrice Decimal  @db.Decimal(10, 2)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model OrderHistory {
  id        String             @id @default(uuid())
  orderId   String
  userId    String?
  action    OrderHistoryAction
  oldValue  String?
  newValue  String?
  createdAt DateTime           @default(now())
  order     Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User?              @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@map("order_history")
}

model Visitor {
  id            String           @id @default(uuid())
  anonId        String           @unique
  userAgent     String?
  ipHash        String?
  firstSeen     DateTime         @default(now())
  lastSeen      DateTime         @updatedAt
  sessions      VisitorSession[]
  device        String?
  browser       String?
  os            String?
  country       String?
  city          String?
  sessionsCount Int              @default(0)

  @@map("visitors")
}

model VisitorSession {
  id              String           @id @default(uuid())
  visitorId       String
  startedAt       DateTime         @default(now())
  endedAt         DateTime?
  entryPage       String?
  exitPage        String?
  events          AnalyticsEvent[]
  visitor         Visitor          @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  referrer        String?
  durationSeconds Int?
  converted       Boolean          @default(false)
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmContent      String?
  utmTerm         String?

  @@map("visitor_sessions")
}

model AnalyticsEvent {
  id        String             @id @default(uuid())
  sessionId String
  type      AnalyticsEventType
  path      String?
  metadata  Json?
  pageTitle String?
  createdAt DateTime           @default(now())
  session   VisitorSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([sessionId])
  @@map("analytics_events")
}

model ABTest {
  id        String          @id @default(uuid())
  key       String          @unique
  name      String
  isActive  Boolean         @default(false)
  createdAt DateTime        @default(now())
  variants  ABTestVariant[]

  @@map("ab_tests")
}

model ABTestVariant {
  id       String @id @default(uuid())
  abTestId String
  key      String
  weight   Int    @default(50)
  abTest   ABTest @relation(fields: [abTestId], references: [id], onDelete: Cascade)

  @@unique([abTestId, key])
  @@map("ab_test_variants")
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?
  action     AuditAction
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime    @default(now())
  user       User?       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?
  title     String
  message   String
  isRead    Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("notifications")
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

enum UserRole {
  COMMERCIAL
  ADMIN
  SUPER_ADMIN
}

enum OrderStatus {
  CREATED
  AWAITING_CALL
  CALLING
  CONFIRMED
  PREPARING
  READY
  DELIVERING
  DELIVERED
  CANCELLED
}

enum CustomerRole {
  PARENT
  STUDENT
  OTHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum SchoolListSource {
  OFFICIAL
  CUSTOM_PHOTO
  CUSTOM_FILE
  CUSTOM_MANUAL
}

enum OrderHistoryAction {
  QUANTITY_CHANGED
  PRODUCT_ADDED
  PRODUCT_REMOVED
  ADDRESS_UPDATED
  NOTE_ADDED
  STATUS_CHANGED
  ORDER_CONFIRMED
  PDF_GENERATED
  OTHER
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  PDF_DOWNLOAD
  VIEW
  EXPORT
}

enum AnalyticsEventType {
  PAGE_VIEW
  SCROLL
  CLICK
  SCHOOL_SEARCH
  PRODUCT_VIEW
  ADD_TO_CART
  CART_ABANDON
  CONVERSION
  SEARCH
  CHECKOUT_STARTED
  ORDER_CREATED
}